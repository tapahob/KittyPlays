{
  "manifest_version": 3,
  "name": "KittyPlays для YouTube",
  "version": "1.3.5",
  "description": "Локальная интерполяция с выбором частоты кадров и счётчиком FPS поверх видео.",
  "icons": { "128": "icons/kittyplays-128.png" },
  "action": { "default_title": "Toggle KittyPlays in this tab" },
  "background": { "service_worker": "action.js" },
  "permissions": ["storage", "nativeMessaging"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["motion.js", "renderer.js", "neural/rt.js", "neural.js", "vfg.js", "player.js"],
    "css": ["player.css"],
    "run_at": "document_idle"
  }]
}
